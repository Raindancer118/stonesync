#!/bin/sh
set -eu
. /usr/local/bin/admin-env.sh

force=false
vault_id=""
for arg in "$@"; do
	case "$arg" in
		--force) force=true ;;
		*) vault_id="$arg" ;;
	esac
done

if [ "$vault_id" = "" ]; then
	echo "Usage: ss-delete-vault <vaultId> [--force]" >&2
	echo "  --force: also hard-deletes vaults that still have (even soft-deleted) documents," >&2
	echo "           erasing their content, sync history and git history for good." >&2
	exit 1
fi

if [ "$force" = "true" ]; then
	# --force hard-deletes every document row (and everything referencing them) in one
	# all-or-nothing transaction. A still-connected client sending a real edit for one of
	# those documents right as that transaction runs can insert a fresh yjs_updates row after
	# that document's own rows were already wiped, so the final documents-table delete then
	# fails its foreign key check - the whole transaction rolls back cleanly on that, nothing
	# is left half-deleted. Each retry is a brand new transaction that re-reads the vault's
	# current document list from scratch, so it converges once that race window closes
	# (typically within a couple of seconds, once the lingering client's last edit lands).
	attempt=1
	max_attempts=5
	while [ "$attempt" -le "$max_attempts" ]; do
		http_code=$(curl -s -o /tmp/ss-delete-vault.out -w "%{http_code}" -X DELETE "$ADMIN_BASE/vaults/$vault_id?force=true" -H "$ADMIN_AUTH")
		if [ "$http_code" -lt 300 ]; then
			break
		fi
		if [ "$http_code" = "500" ] && [ "$attempt" -lt "$max_attempts" ]; then
			echo "Attempt $attempt/$max_attempts hit a concurrent write - retrying in 2s..." >&2
			sleep 2
			attempt=$((attempt + 1))
			continue
		fi
		break
	done
else
	# Server rejects this (409) if the vault still has documents - run ss-docs "$1"
	# first to check, or re-run with --force. This is intentional: nothing here cascades
	# away synced content unless explicitly told to.
	http_code=$(curl -s -o /tmp/ss-delete-vault.out -w "%{http_code}" -X DELETE "$ADMIN_BASE/vaults/$vault_id" -H "$ADMIN_AUTH")
fi
if [ "$http_code" = "409" ]; then
	echo "Refused: this vault still has documents. Run 'ss-docs $vault_id' to see them, or re-run with --force." >&2
	exit 1
elif [ "$http_code" -ge 300 ]; then
	echo "Failed (HTTP $http_code):" >&2
	cat /tmp/ss-delete-vault.out >&2
	exit 1
fi
echo "vault $vault_id deleted."
