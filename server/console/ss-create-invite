#!/bin/sh
set -eu
. /usr/local/bin/admin-env.sh

if [ "${3:-}" = "" ]; then
	echo "Usage: ss-create-invite <vaultId> <OWNER|EDITOR|VIEWER> <inviteeEmail>" >&2
	echo "(run ss-vaults first to find the vault id; the invite can only be redeemed by" >&2
	echo "whoever logs into Authentik with exactly this email)" >&2
	exit 1
fi

payload=$(jq -n --arg role "$2" --arg email "$3" '{role: $role, inviteeEmail: $email}')

curl -sf -X POST "$ADMIN_BASE/vaults/$1/invites" \
	-H "$ADMIN_AUTH" -H "Content-Type: application/json" \
	-d "$payload" | jq .
